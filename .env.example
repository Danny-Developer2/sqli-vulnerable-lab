# Copia este archivo a .env y ajusta los valores para tu entorno local.
# Todos los valores son FICTICIOS y sólo sirven para el laboratorio educativo.

# --- Base de datos (MariaDB) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=sqli_lab
DB_USER=lab_user
DB_PASSWORD=lab_pass_ficticio_cambiar

# Contraseña de root del contenedor MariaDB (solo para administración local)
MARIADB_ROOT_PASSWORD=root_ficticio_cambiar

# --- Aplicación Flask ---
SECRET_KEY=secreto_ficticio_cambiar_en_produccion

# URL base usada por las pruebas (opcional)
LAB_URL=http://127.0.0.1:8080
